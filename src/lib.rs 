use zed_extension_api::{self as zed, *};
use serialport::SerialPortInfo;
use std::sync::{Arc, Mutex};
use std::thread;
use std::time::Duration;

// State for the serial monitor
struct SerialMonitorState {
    port_name: Option<String>,
    baud_rate: u32,
    is_connected: bool,
    buffer: Vec<String>,
    port_handle: Option<Box<dyn serialport::SerialPort>>,
}

impl Default for SerialMonitorState {
    fn default() -> Self {
        Self {
            port_name: None,
            baud_rate: 115200,
            is_connected: false,
            buffer: Vec::new(),
            port_handle: None,
        }
    }
}

static STATE: Mutex<SerialMonitorState> = Mutex::new(SerialMonitorState {
    port_name: None,
    baud_rate: 115200,
    is_connected: false,
    buffer: Vec::new(),
    port_handle: None,
});

/// Get list of available serial ports
fn list_serial_ports() -> Vec<SerialPortInfo> {
    match serialport::available_ports() {
        Ok(ports) => ports,
        Err(_) => Vec::new(),
    }
}

/// Connect to a serial port
fn connect_port(port_name: &str, baud_rate: u32) -> Result<(), String> {
    match serialport::new(port_name, baud_rate)
        .timeout(Duration::from_millis(100))
        .open()
    {
        Ok(port) => {
            let mut state = STATE.lock().unwrap();
            state.port_name = Some(port_name.to_string());
            state.baud_rate = baud_rate;
            state.is_connected = true;
            state.port_handle = Some(port);
            state.buffer.clear();

            // Spawn a thread to read from the port
            spawn_read_thread();

            Ok(())
        }
        Err(e) => Err(format!("Failed to open port: {}", e)),
    }
}

/// Disconnect from the serial port
fn disconnect_port() {
    let mut state = STATE.lock().unwrap();
    state.is_connected = false;
    state.port_handle = None;
    state.port_name = None;
}

/// Spawn a background thread that reads from the serial port
fn spawn_read_thread() {
    thread::spawn(|| {
        let mut read_buffer = [0; 1024];

        loop {
            let state = STATE.lock().unwrap();

            if !state.is_connected {
                break;
            }

            // We can't read here because we're holding the lock
            // In a real implementation, we'd use a channel to pass data
            drop(state);

            thread::sleep(Duration::from_millis(100));
        }
    });
}

/// Clear the output buffer
fn clear_buffer() {
    let mut state = STATE.lock().unwrap();
    state.buffer.clear();
}

/// Get current output as a formatted string
fn get_output() -> String {
    let state = STATE.lock().unwrap();
    state.buffer.join("\n")
}

pub fn extension_api_version() -> String {
    "0.3".to_string()
}

pub fn initialize() {
    // Register commands
    zed::register_command("serial_monitor: toggle", toggle_panel);
    zed::register_command("serial_monitor: clear", clear_output);
}

fn toggle_panel() {
    // This would show/hide the serial monitor panel
    // Zed API will handle the panel UI
}

fn clear_output() {
    clear_buffer();
}

